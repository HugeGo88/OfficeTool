<Page
    x:Class="OfficeTool.Views.WriterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:helpers="using:OfficeTool.Helpers"
    mc:Ignorable="d">

  <Grid x:Name="ContentArea" Padding="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="16"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Left Column: Markdown Editor -->
    <Grid Grid.Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <TextBlock 
        Grid.Row="0"
        x:Uid="Writer_PageTitle"
        Style="{StaticResource SubtitleTextBlockStyle}"
        Margin="0,0,0,8"/>

      <!-- Form Fields -->
      <Grid Grid.Row="1" Margin="0,0,0,12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Row 0: Header Options -->
        <StackPanel 
          Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
          Orientation="Horizontal"
          Spacing="16"
          Margin="0,0,0,8">

          <CheckBox 
            x:Uid="Writer_IncludeHeader"
            IsChecked="{x:Bind ViewModel.Header, Mode=TwoWay}"/>

          <CheckBox 
            x:Uid="Writer_CustomDate"
            IsChecked="{x:Bind ViewModel.CustomDate, Mode=TwoWay}"/>

          <CheckBox 
            x:Uid="Writer_IncludeSignature"
            IsChecked="{x:Bind ViewModel.Signing, Mode=TwoWay}"/>
        </StackPanel>

        <!-- Row 1: Company -->
        <TextBox 
          Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
          x:Uid="Writer_Company"
          Text="{x:Bind ViewModel.Company, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          Margin="0,0,0,8"/>

        <!-- Row 2: Name and Last Name -->
        <TextBox 
          Grid.Row="2" Grid.Column="0"
          x:Uid="Writer_Name"
          Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          Margin="0,0,0,8"/>

        <TextBox 
          Grid.Row="2" Grid.Column="2"
          x:Uid="Writer_LastName"
          Text="{x:Bind ViewModel.LastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          Margin="0,0,0,8"/>

        <!-- Row 3: Address and City -->
        <TextBox 
          Grid.Row="3" Grid.Column="0"
          x:Uid="Writer_Address"
          Text="{x:Bind ViewModel.Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          Margin="0,0,0,8"/>

        <TextBox 
          Grid.Row="3" Grid.Column="2"
          x:Uid="Writer_City"
          Text="{x:Bind ViewModel.City, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          Margin="0,0,0,8"/>

        <!-- Row 4: Date and Subject -->
        <CalendarDatePicker
          Grid.Row="4" Grid.Column="0"
          x:Uid="Writer_Date"
          Date="{x:Bind ViewModel.Date, Mode=TwoWay}"
          DateFormat="{}{day.integer}.{month.integer}.{year.full}"
          FirstDayOfWeek="Monday"
          Margin="0,0,0,8"/>

        <TextBox 
          Grid.Row="4" Grid.Column="2"
          x:Uid="Writer_Subject"
          Text="{x:Bind ViewModel.Subject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          Margin="0,0,0,8"/>

        <!-- Separator -->
        <Border 
          Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
          Height="1" 
          Background="{ThemeResource DividerStrokeColorDefaultBrush}"
          Margin="0,4,0,0"/>
      </Grid>

      <TextBox 
        Grid.Row="2"
        AcceptsReturn="True"
        TextWrapping="Wrap"
        ScrollViewer.VerticalScrollBarVisibility="Auto"
        x:Uid="Writer_MarkdownText"
        Text="{x:Bind ViewModel.MarkdownText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    </Grid>

    <!-- Right Column: WebView2 Preview -->
    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <TextBlock 
        Grid.Row="0"
        x:Uid="Writer_Preview"
        Style="{StaticResource SubtitleTextBlockStyle}"
        Margin="0,0,0,8"/>

      <CommandBar
        Grid.Row="1"
        Margin="0,0,0,8"
        Background="Transparent"
        DefaultLabelPosition="Right"
        IsOpen="False">
        <AppBarButton
          x:Uid="WriterView_LoadButton"
          Command="{x:Bind ViewModel.LoadLetterCommand}"
          Icon="OpenLocal">
          <AppBarButton.KeyboardAccelerators>
            <KeyboardAccelerator Key="O" Modifiers="Control" />
          </AppBarButton.KeyboardAccelerators>
        </AppBarButton>
        <AppBarElementContainer>
          <SplitButton Command="{x:Bind ViewModel.SaveLetterCommand}">
            <SplitButton.KeyboardAccelerators>
              <KeyboardAccelerator Key="S" Modifiers="Control" />
            </SplitButton.KeyboardAccelerators>
            <SplitButton.Content>
              <StackPanel Orientation="Horizontal">
                <Viewbox Height="16" Margin="0,2,0,0">
                  <SymbolIcon Symbol="SaveLocal" />
                </Viewbox>
                <TextBlock Margin="10,0,0,0" x:Uid="WriterView_SaveButton" />
              </StackPanel>
            </SplitButton.Content>
            <SplitButton.Flyout>
              <MenuFlyout>
                <MenuFlyoutItem
                  Icon="Save"
                  x:Uid="WriterView_SaveAs">
                  <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="S" Modifiers="Control,Shift" />
                  </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
              </MenuFlyout>
            </SplitButton.Flyout>
          </SplitButton>
        </AppBarElementContainer>
        <AppBarButton
          x:Uid="WriterView_CreateButton"
          Command="{x:Bind ViewModel.SaveToPdfCommand}"
          Icon="Share" >
          <AppBarButton.KeyboardAccelerators>
            <KeyboardAccelerator Key="E" Modifiers="Control" />
          </AppBarButton.KeyboardAccelerators>
        </AppBarButton>
        <CommandBar.SecondaryCommands>
          <AppBarButton
            x:Uid="WriterView_DelteButton"
            Icon="Delete">
            <AppBarButton.KeyboardAccelerators>
              <KeyboardAccelerator Key="N" Modifiers="Control" />
            </AppBarButton.KeyboardAccelerators>
          </AppBarButton>
        </CommandBar.SecondaryCommands>
      </CommandBar>

      <controls:WebView2 
        x:Name="PreviewWebView"
        Grid.Row="2"
        helpers:WebView2Helper.HtmlContent="{x:Bind ViewModel.HtmlContent, Mode=OneWay}"/>
    </Grid>
  </Grid>
</Page>
